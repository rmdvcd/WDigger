<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WDigger.UI.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Custom title bar (drag region) ═══ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Padding="14,0,0,0">
                <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource AppAccentBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE90F;" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="WDigger" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Diagnóstico y reparación de Windows · Portable v3.0" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Padding="0,0,10,0">
                <Border Background="{ThemeResource SafeSoftBrush}" CornerRadius="10" Padding="9,3,10,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource SafeBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PrivilegeLabel" Text="ADMINISTRADOR" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60"
                                   Foreground="{ThemeResource SafeBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Simulación" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="DryRunSwitch" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Si está activo, las acciones que modifican el sistema solo se registran" />
            </StackPanel>

            <!-- Space reserved for the system caption buttons -->
            <Grid Grid.Column="2" />
        </Grid>

        <!-- ═══ Navigation + content ═══ -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="276"
                        CompactPaneLength="48"
                        AlwaysShowHeader="False"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="Panel de control">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="diagnostics" Content="Diagnóstico">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Herramientas" />
                <NavigationViewItem Tag="hardware" Content="Hardware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="repair" Content="Reparación del sistema">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="software" Content="Software">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="tweaks" Content="Ajustes y privacidad">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="drivers" Content="Controladores">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="network" Content="Red">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="advnetwork" Content="Red avanzada">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="devices" Content="Dispositivos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="backup" Content="Copias de seguridad">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="activation" Content="Activación">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="recovery" Content="Recuperación">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="eventlog" Content="Eventos y BIOS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="disk" Content="Discos y limpieza">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE76C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ThemeItem" Tag="theme" Content="Tema: Automático" ToolTipService.ToolTip="Cambiar entre tema automático, oscuro y claro">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" Content="Acerca de WDigger">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="PageHost" Grid.Row="0" />

                    <ProgressBar x:Name="ActivityProgress" AutomationProperties.Name="Progreso de la operación" Grid.Row="1" Height="3"
                                 IsIndeterminate="False" Value="0" Visibility="Collapsed" />

                    <!-- ═══ Integrated output / results pane ═══ -->
                    <Border Grid.Row="2"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition x:Name="OutputBodyRow" Height="264" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="16,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="SALIDA" FontSize="10" FontWeight="SemiBold" CharacterSpacing="150"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="Listo" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="460" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                    <ToggleButton x:Name="OutputViewButton" Content="Salida" IsChecked="True"
                                                  Click="OutputViewButton_Click" MinWidth="74" Height="30" FontSize="12" />
                                    <ToggleButton x:Name="TableViewButton" Content="Tabla" IsChecked="False"
                                                  Click="TableViewButton_Click" MinWidth="74" Height="30" FontSize="12" />
                                    <AppBarButton x:Name="CancelOperationButton" Label="Cancelar" LabelPosition="Collapsed"
                                                  Visibility="Collapsed" Click="CancelOperationButton_Click"
                                                  ToolTipService.ToolTip="Cancelar la operación en curso">
                                        <SymbolIcon Symbol="Stop" />
                                    </AppBarButton>
                                    <AppBarButton Label="Copiar" LabelPosition="Collapsed" Click="CopyOutputButton_Click"
                                                  ToolTipService.ToolTip="Copiar la salida al portapapeles">
                                        <SymbolIcon Symbol="Copy" />
                                    </AppBarButton>
                                    <AppBarButton Label="Limpiar" LabelPosition="Collapsed" Click="ClearOutputButton_Click"
                                                  ToolTipService.ToolTip="Borrar la salida">
                                        <SymbolIcon Symbol="Delete" />
                                    </AppBarButton>
                                    <AppBarButton x:Name="OutputCollapseButton" Label="Contraer" LabelPosition="Collapsed"
                                                  Click="OutputCollapseButton_Click"
                                                  ToolTipService.ToolTip="Contraer o expandir el panel">
                                        <FontIcon Glyph="&#xE70D;" />
                                    </AppBarButton>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="OutputBody" Grid.Row="1">
                                <ScrollViewer x:Name="OutputScroller" Padding="16,8,16,12"
                                              Background="{ThemeResource ConsoleBrush}">
                                    <RichTextBlock x:Name="OutputText" FontSize="12"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                                <ScrollViewer x:Name="TableScroller" Padding="16,8,16,12" Visibility="Collapsed">
                                    <StackPanel x:Name="TableHost" Spacing="0" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
