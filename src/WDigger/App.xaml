<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WDigger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WDigger">

    <Application.Resources>
        <ResourceDictionary>
            <!-- WinUI 3 defaults (theme brushes such as TextFillColorSecondaryBrush,
                 control styles, ...) must be merged explicitly once Application.Resources
                 is replaced by a dictionary of our own. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1A0F6CBD" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AD13438" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SafeSoftBrush" Color="#1A107C10" />
                    <SolidColorBrush x:Key="SafeBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="ConsoleBrush" Color="#F7F9FC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SafeSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SafeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ConsoleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#479EF5" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#33479EF5" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#33FF99A4" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SafeSoftBrush" Color="#3327C080" />
                    <SolidColorBrush x:Key="SafeBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="ConsoleBrush" Color="#161B21" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
