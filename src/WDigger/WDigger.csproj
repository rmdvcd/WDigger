<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WDigger</RootNamespace>
    <AssemblyName>WDigger</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre781" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
