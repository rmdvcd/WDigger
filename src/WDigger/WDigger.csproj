<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WDigger</RootNamespace>
    <AssemblyName>WDigger</AssemblyName>
    <StartupObject>WDigger.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wdigger.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>WDigger</AssemblyTitle>
    <Product>WDigger</Product>
    <Description>WinUI 3 native Windows diagnostics and repair toolkit</Description>
    <Version>2.0.0</Version>

    <!-- Portable defaults: one self-contained x64 executable, no installer. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required by WindowsAppSDK SingleFile targets to embed resources.pri. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre781" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Defaults travel inside the EXE and are materialized beside it on demand. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\tweaks.json"
                      Link="config\tweaks.json"
                      LogicalName="WDigger.Configuration.tweaks.json" />
    <EmbeddedResource Include="..\..\config\software.json"
                      Link="config\software.json"
                      LogicalName="WDigger.Configuration.software.json" />
  </ItemGroup>

</Project>
