<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WDigger</RootNamespace>
    <AssemblyName>WDigger</AssemblyName>
    <StartupObject>WDigger.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>WDigger</AssemblyTitle>
    <Product>WDigger Portable</Product>
    <Description>Diagnóstico y reparación nativa de Windows</Description>
    <Version>1.0.0</Version>

    <!-- Portable defaults: one self-contained x64 executable, no installer. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre781" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Defaults travel inside the EXE and are materialized beside it on demand. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\tweaks.json"
                      Link="config\tweaks.json"
                      LogicalName="WDigger.Configuration.tweaks.json" />
    <EmbeddedResource Include="..\..\config\software.json"
                      Link="config\software.json"
                      LogicalName="WDigger.Configuration.software.json" />
  </ItemGroup>

</Project>
