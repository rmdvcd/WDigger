<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WDigger.Views.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WDigger.Views">

    <Grid Padding="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Module header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource AppAccentSoftBrush}"
                    VerticalAlignment="Top">
                <FontIcon x:Name="ModuleIcon" Glyph="&#xE90F;" FontSize="24"
                          Foreground="{ThemeResource AppAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="ModuleTitle" Text="" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="ModuleDescription" Text="" FontSize="12.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left" />
            </StackPanel>

            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="10,5,11,5"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="ModuleBadge" Text="" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <!-- Action cards -->
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActionCards" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="372" ItemHeight="188"
                                       MaximumRowsOrColumns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ActionCardViewModel">
                        <views:ActionCard ViewModel="{x:Bind}" Margin="0,0,12,12" Width="360" Height="176" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
